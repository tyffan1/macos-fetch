#!/bin/zsh
#
# macos — neofetch-style system info + Apple logo for macOS.
#
# Usage:  macos
# Colors turn off automatically when output is piped or NO_COLOR is set.

# human readable size

version="v1.0.2"

hbytes() {
    local b=$1
    if   (( b >= 1099511627776 )); then printf '%.2fTiB' "$(echo "scale=2; $b / 1099511627776" | bc)"
    elif (( b >= 1073741824      )); then printf '%.2fGiB' "$(echo "scale=2; $b / 1073741824" | bc)"
    elif (( b >= 1048576         )); then printf '%.0fMiB' "$(( b / 1048576 ))"
    else                                    printf '%.0fKiB' "$(( b / 1024 ))"
    fi
}

# print N dashes
dashes() {
    local s
    s=$(printf '%*s' "$1" '')
    printf '%s' "${s// /-}"
}

main() {
    # shell-specific: zsh arrays are 1-based, bash arrays are 0-based
    local idx_offset=0
    [[ -n $ZSH_VERSION ]] && idx_offset=1

    for arg in "$@"; do
        case $arg in
            --version)
                printf "macos $version\n"
                return 0
                ;;
            *)
                printf "unknown option: %s\n" "$arg" >&2
                printf "\nusage: macos [--version]\n"
                return 1
                ;;
        esac
    done

    [[ -n $ZSH_VERSION ]] && emulate -L zsh

    # ------------------------------------------------------------------ colors
    local on=""
    [[ -t 1 && -z ${NO_COLOR:-} ]] && on=1

    local reset="" bold="" dim="" logo_c=""
    local -a cyc=()
    if [[ -n $on ]]; then
        reset=$'\033[0m'
        bold=$'\033[1m'
        dim=$'\033[90m'                    # gray (bright black)
        logo_c=${MACOS_LOGO_COLOR:-$'\033[1;37m'}
        cyc=(
            $'\033[1;36m'                  # cyan
            $'\033[1;34m'                  # blue
            $'\033[1;32m'                  # green
            $'\033[1;33m'                  # yellow
            $'\033[1;35m'                  # magenta
            $'\033[1;31m'                  # red
        )
    fi
    local -i n_cyc=${#cyc}
    (( n_cyc == 0 )) && n_cyc=1

    # ------------------------------------------------------------------- logo
    local -a logo=(
        "                    'c."
        "                 ,xNMM."
        "               .OMMMMo"
        "               OMMM0,"
        "     .;loddo:' loolloddol;."
        "   cKMMMMMMMMMMNWMMMMMMMMMM0:"
        " .KMMMMMMMMMMMMMMMMMMMMMMMWd."
        " XMMMMMMMMMMMMMMMMMMMMMMMX."
        ";MMMMMMMMMMMMMMMMMMMMMMMM:"
        ":MMMMMMMMMMMMMMMMMMMMMMMM:"
        ".MMMMMMMMMMMMMMMMMMMMMMMMX."
        " kMMMMMMMMMMMMMMMMMMMMMMMMWd."
        " 'XMMMMMMMMMMMMMMMMMMMMMMMMMMk"
        "  'XMMMMMMMMMMMMMMMMMMMMMMMMK."
        "    kMMMMMMMMMMMMMMMMMMMMMMd"
        "     ;KMMMMMMMWXXWMMMMMMMk."
        "       \"cooc*\"    \"*coo'\""
    )

    # --------------------------------------------------------------- gathering
    local hn hw
    hn=$(scutil --get LocalHostName 2>/dev/null)
    hn=${hn%"${hn##*[![:space:]-]}"}
    [[ -z $hn ]] && hn=$(hostname -s 2>/dev/null)
    [[ -z $hn ]] && hn=mac

    hw=$(system_profiler SPHardwareDataType SPDisplaysDataType 2>/dev/null)

    local os="macOS $(sw_vers -productVersion 2>/dev/null)"
    local build
    build=$(sw_vers -buildVersion 2>/dev/null)
    [[ -n $build ]] && os+=" ($build)"

    local model_name model_id host=""
    model_name=$(print -r -- "$hw" | awk -F': *' '/Model Name:/{print $2; exit}')
    model_id=$(print -r -- "$hw"   | awk -F': *' '/Model Identifier:/{print $2; exit}')
    [[ -n $model_name ]] && host="$model_name"
    [[ -n $model_id   ]] && host="${host:+$host }($model_id)"
    [[ -z $host       ]] && host=$(scutil --get ComputerName 2>/dev/null)

    # uptime
    local boot up_s
    boot=$(sysctl -n kern.boottime 2>/dev/null)
    boot=${boot#*sec = }
    boot=${boot%%,*}
    local uptime=""
    if [[ -n $boot && $boot == <-> ]]; then
        up_s=$(( $(date +%s) - boot ))
        (( up_s < 0 )) && up_s=0
        local -i u_d=$(( up_s / 86400 )) u_h=$(( (up_s % 86400) / 3600 )) u_m=$(( (up_s % 3600) / 60 ))
        local -a up=()
        (( u_d )) && up+=("$u_d $([[ $u_d == 1 ]] && echo day || echo days)")
        up+=("$u_h $([[ $u_h == 1 ]] && echo hour || echo hours)")
        up+=("$u_m $([[ $u_m == 1 ]] && echo min || echo mins)")
        uptime="${(j:, :)up}"
        # bash fallback: join array with ", "
        if [[ -n $BASH_VERSION ]]; then
            uptime=""
            local first=1
            for elem in "${up[@]}"; do
                [[ $first == 1 ]] && first=0 || uptime+=", "
                uptime+="$elem"
            done
        fi
    fi

    # shell / terminal
    local shell="zsh"
    [[ -n $ZSH_VERSION ]] && shell+=" $ZSH_VERSION"
    local term="${TERM_PROGRAM:-${TERM:-unknown}}"
    [[ -n $TERM_PROGRAM && -n $TERM_PROGRAM_VERSION ]] && term+=" $TERM_PROGRAM_VERSION"

    # resolution + gpu
    local res gpu
    res=$(print -r -- "$hw" | grep 'Resolution:' \
        | sed -E 's/.*Resolution:[[:space:]]*//; s/^[[:space:]]+//' \
        | awk '!seen[$0]++' | paste -sd', ' -)
    gpu=$(print -r -- "$hw" | grep 'Chipset Model:' \
        | sed -E 's/.*Chipset Model:[[:space:]]*//; s/^[[:space:]]+//' \
        | awk '!seen[$0]++' | paste -sd', ' -)

    # cpu
    local cpu
    cpu=$(sysctl -n machdep.cpu.brand_string 2>/dev/null)
    [[ -z $cpu ]] && cpu=$(uname -m)
    local -i cores=$(sysctl -n hw.ncpu 2>/dev/null)
    local -i pcores=$(sysctl -n hw.perflevel0.logicalcpu 2>/dev/null)
    local -i ecores=$(sysctl -n hw.perflevel1.logicalcpu 2>/dev/null)
    if (( cores )); then
        if (( pcores && ecores )); then
            cpu+=" (${pcores}P + ${ecores}E, ${cores} cores)"
        else
            cpu+=" (${cores} cores)"
        fi
    fi

    # memory
    local -i pagesize=$(pagesize 2>/dev/null)
    (( pagesize == 0 )) && pagesize=4096
    local -i mem_total=$(sysctl -n hw.memsize 2>/dev/null)
    local mem=""
    if (( mem_total )); then
        local -i used_pages mem_used
        used_pages=$(vm_stat 2>/dev/null | awk '/Pages free|Pages inactive|Pages speculative/{
            gsub(/\./, "", $3); s += $3 } END { print s + 0 }')
        mem_used=$(( mem_total - used_pages * pagesize ))
        (( mem_used < 0 )) && mem_used=0
        mem="$(hbytes $mem_used) / $(hbytes $mem_total) ($(( mem_used * 100 / mem_total ))%)"
    fi

    # disk
    local disk_path=/System/Volumes/Data
    [[ -d $disk_path ]] || disk_path=/
    local -a df_out
    local df_raw
    df_raw=$(df -Pk $disk_path 2>/dev/null | awk 'NR==2 {print $2, $3}')
    if [[ -n $ZSH_VERSION ]]; then
        df_out=(${(z)df_raw})
    else
        read -ra df_out <<< "$df_raw"
    fi
    local disk=""
    if (( ${#df_out} == 2 )); then
        local -i d_total=$(( ${df_out[1]} * 1024 )) d_used=$(( ${df_out[2]} * 1024 ))
        (( d_total )) && disk="$(hbytes $d_used) / $(hbytes $d_total) ($(( d_used * 100 / d_total ))%)"
    fi

    #battery
    local battery=$(pmset -g batt | grep -Eo '[0-9]+%')

    #network status
    local net_status="offline"
    curl -s --max-time 2 https://www.google.com > /dev/null && net_status="online"

    #network speed
    local raw=$(curl -s -o /dev/null -w "%{size_download} %{time_total} %{speed_download}\n" --max-time 15 http://cachefly.cachefly.net/10mb.test)
    local bytes=$(echo "$raw" | awk '{print $3}')
    local net_speed=$(awk  "BEGIN {printf \"%.1f Mbps\", $bytes*8/1000000 }")

    #ip
    local ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)

    #packages
    local packages=$(brew list --formula 2>/dev/null | wc -l | tr -d '[:space:]')

    # ------------------------------------------------------------- info block
    local -a fields=(
        "OS|$os"
        "Host|$host"
        "Kernel|$(uname -sr)"
        "Uptime|$uptime"
        "Shell|$shell"
        "Resolution|$res"
        "Terminal|$term"
        "CPU|$cpu"
        "GPU|$gpu"
        "Memory|$mem"
        "Disk|$disk"
        "Battery|$battery"
        "Network|$net_status"
        "Network Speed|$net_speed"
        "IP|$ip"
        "Packages|$packages"
    )

    # ------------------------------------------------------- config (visible fields)
    local config="$HOME/.config/macos-fetch/params.conf"
    if [[ ! -f $config ]]; then
        mkdir -p "$(dirname "$config")"
        local l
        {
            for l in "${fields[@]}"; do
                printf '%s\n' "${l%%|*}"
            done
        } > "$config"
    fi

    local -a out=() txt=()
    local dash
    dash=$(dashes $(( ${#USER} + 1 + ${#hn} )))
    out+=("${bold}${USER}@${hn}${reset}${dim}${dash}${reset}")
    txt+=("${USER}@${hn}${dash}")

    local f label value
    local -i ci=1
    for f in "${fields[@]}"; do
        label=${f%%|*}
        value=${f#*|}
        [[ -z $value ]] && continue
        if [[ -f $config ]]; then
            grep -qx "$label" "$config" 2>/dev/null || continue
        fi
        out+=("${cyc[ci]}${label}${reset}${dim}:${reset} ${value}")
        txt+=("${label}: ${value}")
        (( ci = ci % n_cyc + 1 ))
    done

    # ------------------------------------------------------------------ print
    local line
    local -i w=0 info_w=0 max i
    local cols=""
    for line in "${logo[@]}"; do (( ${#line} > w )) && w=${#line}; done
    for line in "${txt[@]}"; do (( ${#line} > info_w )) && info_w=${#line}; done

    # terminal width (tput is unreliable inside $(...) — it sees a pipe on stdout)
    local cols="" sz=""
    [[ $COLUMNS == <-> ]] && cols=$COLUMNS
    if [[ -z $cols ]]; then
        sz=$(stty size < /dev/tty 2>/dev/null)
        [[ $sz == <->[[:space:]]<-> ]] && cols=${sz##* }
    fi
    if [[ -z $cols ]]; then
        sz=$(tput cols 2>/dev/null)
        [[ $sz == <-> ]] && cols=$sz
    fi
    [[ $cols == <-> ]] || cols=80
    (( cols >= 20 )) || cols=80
    [[ -n $MACOS_DEBUG ]] && printf "debug: cols=%s w=%s info_w=%s\n" "$cols" "$w" "$info_w" >&2

    if (( cols < w + 2 + info_w )); then
        # narrow terminal: logo on top, info below
        for line in "${logo[@]}"; do printf '%s%s%s\n' "$logo_c" "$line" "$reset"; done
        printf '\n'
        for line in "${out[@]}"; do printf '%s\n' "$line"; done
    else
        max=${#logo}
        (( ${#out} > max )) && max=${#out}
        for (( i = idx_offset; i < max + idx_offset; i++ )); do
            if [[ -n ${out[i]:-} ]]; then
                printf '%s%-*s%s  %s\n' "$logo_c" "$w" "${logo[i]:-}" "$reset" "${out[i]}"
            else
                printf '%s%s%s\n' "$logo_c" "${logo[i]:-}" "$reset"
            fi
        done
    fi

    # ------------------------------------------------------------- color bar
    if [[ -n $on ]] && (( cols >= 70 )); then
        local -i r c
        printf '\n'
        for r in 1 2; do
            printf '  '
            for c in {0..15}; do
                if (( c < 8 )); then
                    if (( r == 1 )); then printf '\033[4%dm    ' "$c"
                    else                  printf '\033[1;4%dm    ' "$c"; fi
                else
                    if (( r == 1 )); then printf '\033[10%dm    ' "$(( c - 8 ))"
                    else                  printf '\033[1;10%dm    ' "$(( c - 8 ))"; fi
                fi
            done
            printf '%s\n' "$reset"
        done
    fi
}

main "$@"
